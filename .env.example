APP_ENV=development

# ScrapeCreators API
SCRAPECREATORS_API_KEY=

# Database (MySQL)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tc_analyzer
DB_USERNAME=root
DB_PASSWORD=

# whisper.cpp
WHISPER_BINARY=/path/to/whisper.cpp/build/bin/whisper-cli
WHISPER_MODEL_PATH=/path/to/whisper.cpp/models/ggml-small.bin

# Ollama (local LLM)
OLLAMA_HOST=http://localhost:11434
